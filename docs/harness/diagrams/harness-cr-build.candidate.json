  "cards": [
    {
      "dot": "rose",
      "title": "Gates G1-G6",
      "items": [
        "G1 worth it? judgment, operator (intake rules, reuse check)",
        "G2 ready? judgment, operator go on goal, items and blast",
        "G3 commit? hooks pre-commit and commit-msg; the agent guard refuses an agent's --no-verify",
        "G4 tests green? judgment of the CR agent, read by the reviewer",
        "G5 review PASS? judgment of the reviewer, recorded on the issue with the commit",
        "G6 push gate? hook gate.py: refuses without Review: PASS for the pushed content (harness #25), a red cost 1-2 check or a secret; only the operator may override"
      ]
    },
    {
      "dot": "cyan",
      "title": "Where tests run",
      "items": [
        "Cost 1 compile, format, lint: every push (G6)",
        "Cost 2 offline with fixtures: every push that touches its paths (G6)",
        "Cost 3-5: after the deploy (part 2, G8)"
      ]
    },
    {
      "dot": "amber",
      "title": "Escapes on record",
      "items": [
        "HARNESS_GATE_OVERRIDE=\"<reason>\" git push, by the operator only",
        "Every fail goes back to Implement and passes the following gates again",
        "Harness changes are reviewed (G5), not gated (G6 runs only the secret scan)"
      ]
    }
