  "cards": [
    {
      "dot": "orange",
      "title": "Value and Ponytail rules",
      "items": [
        "Intake: a finding qualifies if reproduced or seen live, or a real trigger with high blast (medium: small fix), or a missing required protection; purely theoretical cases are dropped",
        "Same area and goal as an open issue: added there, not a new issue",
        "Implement: least code: no code, reuse, standard library, platform, existing dependency, then minimum new code",
        "Review: is it the simplest solution, and exactly the issue?"
      ]
    },
    {
      "dot": "cyan",
      "title": "Where tests run",
      "items": [
        "Cost 1 compile, format, lint: every push",
        "Cost 2 offline with fixtures: every push that touches its paths",
        "Cost 3 live read-only: after the deploy",
        "Cost 4-5 test account or outside effects: only with the operator's consent"
      ]
    },
    {
      "dot": "violet",
      "title": "Who tests",
      "items": [
        "Supervisor: designs the tests first, pushes, runs the live tests",
        "CR agent (sub-agent): writes and runs them, proves each new one red on the parent",
        "Reviewer (sub-agent): reads them; a test that passes without the change is a finding",
        "Push gate: automatic, independent of any agent"
      ]
    },
    {
      "dot": "rose",
      "title": "Refusals",
      "items": [
        "pre-push: a red affected check or suite, a secret in the pushed commits, a gate that cannot run",
        "pre-commit: whitespace errors, a secret in the staged change",
        "commit-msg: fixes/closes/resolves #N",
        "agent guard: an agent's --no-verify or gate override"
      ]
    },
    {
      "dot": "amber",
      "title": "Escapes on record",
      "items": [
        "HARNESS_GATE_OVERRIDE=\"<reason>\" git push, by the operator only",
        "Every red sends the CR back to step 2; a red live item is reverted first",
        "Harness changes are reviewed, not gated"
      ]
    }
  ]
}