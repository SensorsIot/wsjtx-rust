{
  "source": "Accept-Encoding test vectors for RFC 9110 section 12.5.3 (WstxContentCoding::CodingRule), outcomes as tower-http 0.7.1 src/content_encoding.rs (SHA-256 329bf57ef2a989f3128d96b845c4064dbda01a595b7e2fa1a594de77c18b9e56) negotiates them; each vector lists the raw Accept-Encoding fields in request order ([] sends none) and the expected answer: gzip, identity or 406.",
  "vectors": [
    {"accept_encoding": [], "expected": "identity"},
    {"accept_encoding": [""], "expected": "identity"},
    {"accept_encoding": ["identity"], "expected": "identity"},
    {"accept_encoding": ["gzip"], "expected": "gzip"},
    {"accept_encoding": ["GZip"], "expected": "gzip"},
    {"accept_encoding": ["x-gzip"], "expected": "gzip"},
    {"accept_encoding": ["gzip;q=0"], "expected": "identity"},
    {"accept_encoding": ["gzip;q=0,identity;q=0"], "expected": "406"},
    {"accept_encoding": ["identity;q=0,gzip;q=bad"], "expected": "406"},
    {"accept_encoding": ["gzip;q=bad"], "expected": "identity"},
    {"accept_encoding": ["br"], "expected": "identity"},
    {"accept_encoding": ["br,identity;q=0"], "expected": "406"},
    {"accept_encoding": ["gzip;q=0.5"], "expected": "gzip"},
    {"accept_encoding": ["gzip;q=0.5,identity;q=1"], "expected": "identity"},
    {"accept_encoding": ["gzip;q=0.5,identity;q=0.5"], "expected": "gzip"},
    {"accept_encoding": ["identity;q=0,gzip"], "expected": "gzip"},
    {"accept_encoding": ["gzip;q=0."], "expected": "identity"},
    {"accept_encoding": ["gzip;q=1."], "expected": "gzip"},
    {"accept_encoding": ["gzip;Q=0.500"], "expected": "gzip"},
    {"accept_encoding": [" gzip\t; q=0.5 "], "expected": "gzip"},
    {"accept_encoding": ["gzip;q =0.5"], "expected": "identity"},
    {"accept_encoding": ["gzip;q= 0.5"], "expected": "identity"},
    {"accept_encoding": ["gzip;q=.5"], "expected": "identity"},
    {"accept_encoding": ["gzip;q=00.5"], "expected": "identity"},
    {"accept_encoding": ["gzip;q=0.5000"], "expected": "identity"},
    {"accept_encoding": ["gzip;q=1.001"], "expected": "identity"},
    {"accept_encoding": ["gzip;q=-0.1"], "expected": "identity"},
    {"accept_encoding": ["gzip;q=0.5;foo=bar"], "expected": "identity"},
    {"accept_encoding": ["*"], "expected": "gzip"},
    {"accept_encoding": ["*;q=0"], "expected": "406"},
    {"accept_encoding": ["*;q=0.5"], "expected": "gzip"},
    {"accept_encoding": ["*;q=0,gzip;q=0.5"], "expected": "gzip"},
    {"accept_encoding": ["*;q=1,gzip;q=0"], "expected": "identity"},
    {"accept_encoding": ["*;q=1,identity;q=0"], "expected": "gzip"},
    {"accept_encoding": ["*;q=0,identity;q=1"], "expected": "identity"},
    {"accept_encoding": ["*;q=bad"], "expected": "identity"},
    {"accept_encoding": ["*;q=bad,identity;q=0"], "expected": "406"},
    {"accept_encoding": ["gzip;q=0,gzip;q=1"], "expected": "gzip"},
    {"accept_encoding": ["gzip;q=1,gzip;q=0"], "expected": "gzip"},
    {"accept_encoding": ["gzip;q=0,gzip;q=1,*;q=0"], "expected": "406"},
    {"accept_encoding": ["gzip;q=1,gzip;q=0,*;q=0"], "expected": "gzip"},
    {"accept_encoding": ["*;q=0,*;q=1"], "expected": "406"},
    {"accept_encoding": ["*;q=1,*;q=0"], "expected": "gzip"},
    {"accept_encoding": ["*;q=bad,*;q=1"], "expected": "gzip"},
    {"accept_encoding": ["gzip;q=0", "gzip;q=1"], "expected": "gzip"},
    {"accept_encoding": ["gzip;q=0", "gzip;q=1,*;q=0"], "expected": "406"},
    {"accept_encoding": ["br;q=1", "gzip;q=0.4"], "expected": "gzip"},
    {"accept_encoding": ["identity;q=0", "gzip;q=bad"], "expected": "406"},
    {"accept_encoding": ["gzip;q=bad,gzip;q=0.7"], "expected": "gzip"}
  ]
}
